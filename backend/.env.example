# ==============================================================================
# AEGIS Smart Surveillance SOC — Environment Configuration Template
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
# ==============================================================================

# Project & Security
PROJECT_NAME="Smart Surveillance & Crime Monitoring"
SECRET_KEY="SUPER_SECRET_SURVEILLANCE_KEY_CHANGE_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (MongoDB)
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="surveillance_db"
RESET_DB_ON_START=false

# ==============================================================================
# AI MODEL WEIGHTS REGISTRY (Unified 'weights/' Directory with Fallbacks)
# ==============================================================================
PERSON_MODEL_PATH="weights/person_yolo11s.pt"
WEAPON_MODEL_PATH="weights/weapon_yolov5.pt"
FIGHT_MODEL_PATH="weights/fight_yolo11n_cls.pt"
ACCIDENT_MODEL_PATH="weights/accident_yolov8.pt"

# AI Inference & Detection Thresholds
CONFIDENCE_THRESHOLD=0.35
WEAPON_CONFIDENCE_THRESHOLD=0.38
ACCIDENT_CONFIDENCE_THRESHOLD=0.52
FIGHT_MIN_PERSONS_TO_RUN=2
FIGHT_CONFIRM_MIN_PERSONS_SEEN=4
UNATTENDED_HIGH_AFTER_FRAMES=30

# Media Directories (Optional overrides, defaults to project root)
# SCREENSHOTS_DIR="screenshots"
# EVENT_CLIPS_DIR="event_clips"

# ==============================================================================
# EMAIL NOTIFICATIONS (SMTP / GMAIL APP PASSWORD CONFIGURATION)
# ==============================================================================
# IMPORTANT SETUP FOR GMAIL:
# 1. Sign in to your Google Account at https://myaccount.google.com/
# 2. Go to "Security" -> Ensure "2-Step Verification" is turned ON.
# 3. Open https://myaccount.google.com/apppasswords directly.
# 4. Under "App name", enter "AEGIS SOC" and click "Create".
# 5. Google will generate a 16-character App Password (e.g., "abcd efgh ijkl mnop").
# 6. Paste that 16-character password into SMTP_PASSWORD below.
#
# NOTE: Your normal Gmail account login password WILL NOT WORK because Google requires
# 16-character App Passwords for third-party SMTP clients.
# ==============================================================================
EMAIL_ENABLED=true
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME="soc-alerts@example.com"
SMTP_PASSWORD="your-16-character-app-password"
SMTP_FROM_EMAIL="soc-alerts@example.com"
SMTP_FROM_NAME="AEGIS Smart Surveillance SOC"
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY=5
ALERT_RECIPIENT_EMAIL="soc-command@example.com"
