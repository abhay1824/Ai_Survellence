# ==============================================================================
# AEGIS Smart Surveillance SOC — Environment Configuration
# ==============================================================================

# Project Details
PROJECT_NAME="Smart Surveillance & Crime Monitoring"
SECRET_KEY="SUPER_SECRET_SURVEILLANCE_KEY_CHANGE_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (MongoDB)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=surveillance_db

# ==============================================================================
# EMAIL NOTIFICATIONS (SMTP / GMAIL APP PASSWORD CONFIGURATION)
# ==============================================================================
# IMPORTANT SETUP FOR GMAIL:
# 1. Sign in to your Google Account at https://myaccount.google.com/
# 2. Go to "Security" -> Ensure "2-Step Verification" is turned ON.
# 3. Open https://myaccount.google.com/apppasswords directly.
# 4. Under "App name", enter "AEGIS SOC" and click "Create".
# 5. Google will generate a 16-character App Password (e.g., "abcd efgh ijkl mnop").
# 6. Paste that 16-character password into SMTP_PASSWORD below (spaces are automatically handled).
#
# NOTE: Your normal Gmail account login password WILL NOT WORK because Google requires
# 16-character App Passwords for third-party SMTP clients.
# ==============================================================================
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_FROM_NAME=AEGIS Smart Surveillance SOC
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY=5

# AI Model Paths
WEAPON_MODEL_PATH="OD-WeaponDetection/Weapons and similar handled objects/Sohas_weapon-Detection-YOLOv5/runs/detect/weapon6cls/weights/best.pt"
