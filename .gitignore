# ==============================================================================
# AEGIS Smart Surveillance SOC — Monorepo Git Ignore Rules
# ==============================================================================

# 1. Environment & Secret Credentials
.env
*.env
backend/.env
frontend/.env
*.pem
*.key

# 2. Python Caches & Environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/

# 3. Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.next/
*.tsbuildinfo

# 4. Model Weights & Inference Artifacts (Large Files)
*.pt
*.onnx
*.engine
*.bin
*.weights
!weights/.gitkeep

# 5. Raw Datasets & Training Dumps
ACCIDENT/
Dataaset2/
Dataaset2_YOLO/
OD-WeaponDetection/
RWF-2000/
WD/
acc/
accident_frames/
fight_frames/
debug_crops/
hard_negatives/
demo_images/
runs/

# 6. Runtime Media Outputs (keep folder structure via .gitkeep)
event_clips/*
!event_clips/.gitkeep
screenshots/*
!screenshots/.gitkeep
backend/event_clips/*
!backend/event_clips/.gitkeep
backend/screenshots/*
!backend/screenshots/.gitkeep
sample_videos/*.mp4
sample_videos/*.avi

# 7. Scratch & Temporary Experiment Artifacts
scratch/
*.jpg
*.jpeg
*.png
!backend/tests/fixtures/*.jpg
!backend/tests/fixtures/*.png
*.mp4
!backend/tests/fixtures/*.mp4
*.pdf
!backend/tests/fixtures/*.pdf
*.csv
*.lnk

# 8. OS & IDE Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
